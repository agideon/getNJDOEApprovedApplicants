[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# mechanicalsoup is the only package the script itself imports (it in
# turn pulls in requests, beautifulsoup4, lxml, etc. as transitive
# deps). pipenv/virtualenv/distlib/filelock/platformdirs/python-discovery
# used to be listed here too, but those are dependencies of the pipenv
# *tool*, not of the app — they leaked in from an earlier version of the
# Dockerfile that pip-installed pipenv and mechanicalsoup together into
# the same environment and froze the whole thing as one flat list.
mechanicalsoup = "==1.4.0"
# For bin/matchApprovalsToSheet.py: reads/writes a Google Sheet via a
# service-account credential (see app/secrets/README.md and CLAUDE.md).
# Pulls in google-auth (and its small transitive deps) rather than the
# much heavier full google-api-python-client stack.
gspread = "*"
# For bin/matchApprovalsToSheet.py's nickname-aware matching (e.g. "Andy"
# vs "Andrew"): a hand-curated nickname<->formal-name dataset. Nickname
# relationships aren't inferable from spelling/edit-distance the way
# typos are, and are inherently ambiguous (e.g. "Andy" could be short for
# Andrea, Anderson, or Andrew) — hence a lookup table, and hence such
# matches only ever get surfaced for manual review, never auto-confirmed.
nicknames = "*"

[dev-packages]

[requires]
python_version = "3.14"
